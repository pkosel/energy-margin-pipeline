use flake

# Optional, so a fresh clone still gets a shell before .env exists.
dotenv_if_exists .env

# Point host psql at the warehouse container's published port; the defaults
# mirror .env.example so bare `psql` works even without .env.
export PGHOST=localhost
export PGPORT="${WAREHOUSE_DB_PORT:-5432}"
export PGUSER="${WAREHOUSE_DB_USER:-energy}"
export PGPASSWORD="${WAREHOUSE_DB_PASSWORD:-energy}"
export PGDATABASE="${WAREHOUSE_DB_NAME:-energy}"
