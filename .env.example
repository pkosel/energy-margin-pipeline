# Copy to .env before the first `just up`:
#   cp .env.example .env
#
# .env is gitignored. Docker Compose reads it automatically; direnv loads it
# into your shell so bare `psql` works.

# --------------------
# File ownership
# --------------------
# Containers write into bind mounts (airflow/logs, dbt/target, .pytest_cache).
# Without this they land root-owned and need sudo to clean up.
# Get yours with: id -u
AIRFLOW_UID=1000

# --------------------
# Airflow metadata database (not exposed to the host)
# --------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# --------------------
# Airflow secrets
# --------------------
# Both are required: Compose refuses to start with either one empty.
# Generate the Fernet key with:
#   docker run --rm apache/airflow:3.3.0 python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Any long random string, e.g. `openssl rand -hex 32`
AIRFLOW_JWT_SECRET=

# Airflow web login
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# --------------------
# Analytics warehouse (published on localhost)
# --------------------
WAREHOUSE_DB_USER=energy
WAREHOUSE_DB_PASSWORD=energy
WAREHOUSE_DB_NAME=energy
# Change if 5432 is already taken on the host.
WAREHOUSE_DB_PORT=5432

# dbt writes here; models override it per directory in dbt_project.yml
DBT_SCHEMA=analytics
